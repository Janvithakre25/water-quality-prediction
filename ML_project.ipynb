      "source": [
        "print(\"--- Dataset Information ---\")\n",
        "print(df.info())\n",
        "print(\"\\n--- Missing Values Audit ---\")\n",
        "print(df.isnull().sum())\n",
        "print(\"\\n--- Target Class Distribution (water_quality) ---\")\n",
