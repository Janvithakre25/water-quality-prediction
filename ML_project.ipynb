      ],
      "source": [
        "cm = confusion_matrix(y_test, y_pred)\n",
        "plt.figure(figsize=(6, 4.5))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='YlGnBu', xticklabels=[\"Safe\", \"Moderate\", \"Unsafe\"], yticklabels=[\"Safe\", \"Moderate\", \"Unsafe\"])\n",
        "plt.title('Test Set Confusion Matrix (240 Samples)', fontsize=12, fontweight='bold')\n",
        "plt.xlabel('Predicted Class')\n",
        "plt.ylabel('Actual Class')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 12,
      "metadata": {},
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": "<Figure size ...>"
