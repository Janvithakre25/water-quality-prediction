          "output_type": "display_data"
        }
      ],
      "source": [
        "importances = final_model.feature_importances_\n",
        "indices = np.argsort(importances)\n",
        "sorted_feats = [feature_cols[i] for i in indices]\n",
        "sorted_imps = importances[indices]\n",
        "\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "sns.barplot(x=sorted_imps, y=sorted_feats, hue=sorted_feats, palette='crest', legend=False)\n",
        "plt.title('Random Forest Feature Importances', fontsize=12, fontweight='bold')\n",
        "plt.xlabel('Importance Score')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Model & Scaler Export\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 13,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Saved model.pkl and scaler.pkl successfully.\n"
          ]
        }
      ],
      "source": [
        "os.makedirs('models', exist_ok=True)\n",
        "\n",
        "with open('models/model.pkl', 'wb') as f:\n",
        "    pickle.dump(final_model, f)\n",
        "with open('model.pkl', 'wb') as f:\n",
        "    pickle.dump(final_model, f)\n",
        "\n",
        "with open('models/scaler.pkl', 'wb') as f:\n",
        "    pickle.dump(scaler, f)\n",
        "with open('scaler.pkl', 'wb') as f:\n",
        "    pickle.dump(scaler, f)\n",
        "\n",
        "print(\"Saved model.pkl and scaler.pkl successfully.\")"
      ]
    },
    {
